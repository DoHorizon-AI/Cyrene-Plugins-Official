<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cyrene-onebot-v11</AssemblyName>
    <Description>Native AOT DirectPluginRuntime host for the OneBot v11 connector.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cyrene.OneBot.V11.Core/Cyrene.OneBot.V11.Core.csproj" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
  </ItemGroup>
</Project>
