<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cyrene-im</AssemblyName>
    <Description>Native AOT DirectPluginRuntime host for the QQ/IM connector.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cyrene.Im.Core/Cyrene.Im.Core.csproj" />
    <ProjectReference Include="../Cyrene.Plugin.RuntimeHost/Cyrene.Plugin.RuntimeHost.csproj" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
  </ItemGroup>
</Project>
