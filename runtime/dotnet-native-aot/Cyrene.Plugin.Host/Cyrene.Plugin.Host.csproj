<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cyrene-plugin-host</AssemblyName>
    <Description>Standalone Native AOT executable for Cyrene Plugin Package (M3).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cyrene.Plugin.Core/Cyrene.Plugin.Core.csproj" />
  </ItemGroup>
</Project>
