[Unit]
Description=Cyrene Workspace Connector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cyrene
Group=cyrene
EnvironmentFile=/etc/cyrene/workspace-connector.env
LoadCredential=product-credentials.json:/etc/cyrene/workspace-product-credentials.json
Environment=CYRENE_CONNECTOR_PRODUCT_CREDENTIAL_MAP=%d/product-credentials.json
ExecStart=/usr/lib/cyrene/components/cy-workspace-connector
Restart=on-failure
RestartSec=2s
StateDirectory=cyrene/workspace-connector
StateDirectoryMode=0700
ReadWritePaths=/var/lib/cyrene/workspace-connector
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
