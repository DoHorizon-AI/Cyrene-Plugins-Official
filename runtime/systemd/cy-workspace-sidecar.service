[Unit]
Description=Cyrene Workspace Sidecar
After=local-fs.target

[Service]
Type=simple
User=cyrene
Group=cyrene
EnvironmentFile=/etc/cyrene/workspace-sidecar.env
ExecStart=/usr/lib/cyrene/components/cy-workspace-sidecar
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
