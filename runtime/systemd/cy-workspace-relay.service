[Unit]
Description=Cyrene Workspace Relay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cyrene
Group=cyrene
EnvironmentFile=/etc/cyrene/workspace-relay.env
ExecStart=/usr/lib/cyrene/components/cy-workspace-relay
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
