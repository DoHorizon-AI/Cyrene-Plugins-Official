FROM ubuntu:22.04
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home cyrene
COPY --chown=10001:10001 cy-workspace-sidecar /usr/local/bin/cy-workspace-sidecar
USER 10001:10001
EXPOSE 50052
ENTRYPOINT ["/usr/local/bin/cy-workspace-sidecar"]
