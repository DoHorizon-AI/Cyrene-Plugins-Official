FROM ubuntu:22.04
ARG COMPONENT_ID=cy-workspace-frontend-bridge
ARG TARGET_ID=windows-10.0-x86_64-docker-linux
ARG SOURCE_REPOSITORY=https://github.com/DoHorizon-AI/Cyrene-Plugins-Official
ARG SOURCE_REVISION=unknown
ARG COMPONENT_VERSION=unknown
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home cyrene
COPY --chown=10001:10001 cyrene-workspace-frontend-bridge /usr/local/bin/cyrene-workspace-frontend-bridge
RUN install -d -o 10001 -g 10001 -m 0700 /run/cyrene-frontend-bridge
LABEL io.cyrene.component.id=${COMPONENT_ID} \
      io.cyrene.component.target-id=${TARGET_ID} \
      org.opencontainers.image.source=${SOURCE_REPOSITORY} \
      org.opencontainers.image.revision=${SOURCE_REVISION} \
      org.opencontainers.image.version=${COMPONENT_VERSION}
ENV CYRENE_BRIDGE_UDS=/run/cyrene-frontend-bridge/frontend.sock \
    CYRENE_BRIDGE_HEALTH_ADDR=127.0.0.1:18082
USER 10001:10001
EXPOSE 18082
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:18082/readyz || exit 1
ENTRYPOINT ["/usr/local/bin/cyrene-workspace-frontend-bridge"]
