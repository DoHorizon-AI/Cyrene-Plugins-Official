{
  "schemaVersion": 1,
  "id": "cyrene.training.llama-factory",
  "name": "LLaMA-Factory Trainer",
  "version": "0.1.0",
  "description": "Compiles Product training intent into a LLaMA-Factory run directory and launch description.",
  "kind": "capability-plugin",
  "capabilities": [
    "training.llama-factory.v1"
  ],
  "supportedServices": [
    "Cyrene-Yield"
  ],
  "methods": [
    {
      "name": "inspect",
      "interfaceVersion": "1",
      "executionMode": "service",
      "inputSchema": "contracts/v1/schema.json#/$defs/InspectRequest",
      "outputSchema": "contracts/v1/schema.json#/$defs/InspectResponse"
    },
    {
      "name": "compile",
      "interfaceVersion": "1",
      "executionMode": "service",
      "inputSchema": "contracts/v1/schema.json#/$defs/CompileRequest",
      "outputSchema": "contracts/v1/schema.json#/$defs/CompileResponse"
    },
    {
      "name": "parse_event",
      "interfaceVersion": "1",
      "executionMode": "service",
      "inputSchema": "contracts/v1/schema.json#/$defs/ParseEventRequest",
      "outputSchema": "contracts/v1/schema.json#/$defs/ParseEventResponse"
    }
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "llama_factory:LlamaFactoryTrainingPlugin",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {
      "executable": "prepared-runtime",
      "args": [
        "-B",
        "src/cyrene_plugin_runtime/bootstrap.py",
        "--entrypoint",
        "llama_factory:LlamaFactoryTrainingPlugin"
      ]
    }
  },
  "compatibility": {
    "platformVersion": ">=0.1.0",
    "requiresPython": ">=3.11",
    "os": [
      "linux"
    ]
  },
  "state": {
    "isStateful": false,
    "storageCategory": "stateless",
    "retentionPolicyOnUninstall": "retain"
  },
  "profiles": [
    "reactor",
    "all"
  ],
  "contributions": {
    "nodes": [
      {
        "type": "training.llama_factory",
        "version": "0.1.0",
        "title": "LLaMA-Factory Fine-Tuning",
        "owner": "Cyrene-Reactor",
        "category": "Training",
        "description": "Fine-tune models using LLaMA-Factory with LoRA, QLoRA, or full-parameter tuning.",
        "color": "#6366f1",
        "inputs": [
          {
            "name": "dataset",
            "label": "Training Dataset",
            "kind": "dataset"
          },
          {
            "name": "baseModel",
            "label": "Base Model",
            "kind": "model"
          }
        ],
        "outputs": [
          {
            "name": "trainedModel",
            "label": "Fine-Tuned Model",
            "kind": "model"
          }
        ],
        "fields": [
          {
            "name": "stage",
            "label": "Fine-Tuning Stage",
            "kind": "select",
            "choices": [
              "sft",
              "dpo",
              "ppo",
              "pt"
            ],
            "required": true
          },
          {
            "name": "finetuningType",
            "label": "Tuning Method",
            "kind": "select",
            "choices": [
              "lora",
              "full",
              "freeze"
            ],
            "required": true
          },
          {
            "name": "epochs",
            "label": "Training Epochs",
            "kind": "number",
            "integer": true,
            "minimum": 1,
            "maximum": 100,
            "required": true
          },
          {
            "name": "learningRate",
            "label": "Learning Rate",
            "kind": "number",
            "minimum": 0.000001,
            "maximum": 0.1,
            "required": false
          }
        ],
        "defaults": {
          "stage": "sft",
          "finetuningType": "lora",
          "epochs": 3,
          "learningRate": 0.0002
        },
        "execution": {
          "kind": "task",
          "adapter": "cyrene.training.llama-factory",
          "mutableFields": [
            "epochs",
            "learningRate"
          ],
          "checkpoint": true
        }
      }
    ],
    "mcp_tools": [
      "llama_factory_compile",
      "llama_factory_inspect",
      "llama_factory_parse_event"
    ],
    "log_sources": [
      "training.loss",
      "training.progress"
    ]
  }
}
