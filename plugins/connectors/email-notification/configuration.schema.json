{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cyrene.io/tool.provider.v1.email-notification/configuration.schema.json",
  "title": "Independent SMTP email notification binding",
  "type": "object",
  "required": [
    "smtp_host",
    "smtp_port",
    "sender",
    "recipients",
    "state_db_path",
    "context_hmac_key_env_ref",
    "caller_workload",
    "audience",
    "organization_id",
    "workspace_id"
  ],
  "properties": {
    "smtp_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "description": "Binding-owned DNS hostname or IP address only; URLs are rejected."
    },
    "smtp_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "tls_mode": {
      "type": "string",
      "enum": ["implicit", "starttls", "loopback_test_plain"],
      "default": "implicit"
    },
    "allow_loopback_test_transport": {"type": "boolean", "default": false},
    "timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 60,
      "default": 15
    },
    "sender": {
      "type": "string",
      "format": "email",
      "maxLength": 320,
      "description": "Binding-owned RFC 5321 mailbox used for the From and envelope sender."
    },
    "recipients": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
      "additionalProperties": {
        "type": "string",
        "format": "email",
        "maxLength": 320
      },
      "description": "Named recipient_ref aliases mapped to binding-owned mailboxes."
    },
    "state_db_path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path to a private SQLite transport replay ledger. The parent directory must be owner-only."
    },
    "smtp_username_env_ref": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "smtp_password_env_ref": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "context_hmac_key_env_ref": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
      "description": "Environment variable containing exactly 64 hexadecimal characters for the binding-scoped 32-byte caller-context key."
    },
    "caller_workload": {"type": "string", "minLength": 1, "maxLength": 200},
    "audience": {"type": "string", "minLength": 1, "maxLength": 200},
    "organization_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "workspace_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "expected_issuer": {"type": "string", "minLength": 1, "maxLength": 500},
    "expected_subject": {"type": "string", "minLength": 1, "maxLength": 500}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"tls_mode": {"const": "loopback_test_plain"}}, "required": ["tls_mode"]},
      "then": {
        "properties": {"allow_loopback_test_transport": {"const": true}},
        "required": ["allow_loopback_test_transport"]
      }
    },
    {
      "if": {"required": ["smtp_username_env_ref"]},
      "then": {"required": ["smtp_password_env_ref"]}
    },
    {
      "if": {"required": ["smtp_password_env_ref"]},
      "then": {"required": ["smtp_username_env_ref"]}
    }
  ]
}
