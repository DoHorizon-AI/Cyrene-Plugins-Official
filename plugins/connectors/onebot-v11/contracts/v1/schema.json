{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cyrene.io/qq.client.v1/qq-client.schema.json",
  "title": "Cyrene QQ client extension contract",
  "description": "Fixed QQ operation requests and responses. The operation is selected by the direct method name; service/method passthrough is forbidden.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["params"],
      "properties": {
        "params": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 128,
          "properties": {
            "account_id": {"$ref": "#/$defs/identifier"},
            "uin": {"$ref": "#/$defs/identifier"},
            "uid": {"$ref": "#/$defs/identifier"},
            "user_id": {"$ref": "#/$defs/identifier"},
            "user_uid": {"$ref": "#/$defs/identifier"},
            "user_uin": {"$ref": "#/$defs/identifier"},
            "peer_uid": {"$ref": "#/$defs/identifier"},
            "conversation_id": {"$ref": "#/$defs/identifier"},
            "group_id": {"$ref": "#/$defs/identifier"},
            "group_code": {"$ref": "#/$defs/identifier"},
            "message_id": {"$ref": "#/$defs/identifier"},
            "sequence": {"type": "integer", "minimum": 0},
            "random": {"type": "integer", "minimum": 0},
            "timestamp": {"type": "integer", "minimum": 0},
            "request_id": {"$ref": "#/$defs/identifier"},
            "request_kind": {"type": "string", "minLength": 1},
            "sub_type": {"type": "string", "minLength": 1},
            "count": {"type": "integer", "minimum": 0},
            "offset": {"type": "integer", "minimum": 0},
            "page": {"type": "integer", "minimum": 0},
            "page_size": {"type": "integer", "minimum": 0},
            "start_time": {"type": "integer", "minimum": 0},
            "end_time": {"type": "integer", "minimum": 0},
            "scope": {"type": "string", "minLength": 1},
            "comment": {"type": "string", "maxLength": 2048},
            "approve": {"type": "boolean"},
            "secret_ref": {"type": "string", "minLength": 1},
            "events": {"type": "array", "items": {"type": "string"}},
            "event": {"type": "string", "minLength": 1},
            "peer": {"type": "object"},
            "source": {"type": "object"},
            "destination": {"type": "object"},
            "elements": {"type": "array"},
            "attributes": {"type": "object"},
            "reply": {"type": "object"},
            "message": {"type": "object"},
            "messages": {"type": "array"},
            "message_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
            "filter": {"type": "object"},
            "query": {"type": "string"},
            "keywords": {"type": "string"},
            "text": {"type": "string"},
            "name": {"type": "string"},
            "remark": {"type": "string"},
            "nickname": {"type": "string"},
            "long_nick": {"type": "string"},
            "birthday": {"type": "string"},
            "gender": {"type": "string"},
            "header": {"type": "string"},
            "status": {"type": "string"},
            "device_id": {"$ref": "#/$defs/identifier"},
            "like_id": {"$ref": "#/$defs/identifier"},
            "like_type": {"type": "string"},
            "target_id": {"$ref": "#/$defs/identifier"},
            "member_uid": {"$ref": "#/$defs/identifier"},
            "member_uin": {"$ref": "#/$defs/identifier"},
            "file_id": {"$ref": "#/$defs/identifier"},
            "media_id": {"$ref": "#/$defs/identifier"},
            "folder_id": {"$ref": "#/$defs/identifier"},
            "file_uuid": {"$ref": "#/$defs/identifier"},
            "file_name": {"type": "string"},
            "mime_type": {"type": "string"},
            "model_id": {"$ref": "#/$defs/identifier"},
            "element_id": {"$ref": "#/$defs/identifier"},
            "media_type": {"type": "string"},
            "codec": {"type": "string"},
            "download": {"type": "boolean"},
            "short_link": {"type": "boolean"},
            "source_id": {"$ref": "#/$defs/identifier"},
            "profile": {"type": "object"},
            "vendor_request": {"type": "object"},
            "login_policy": {"type": "string"},
            "platform": {"type": "string"},
            "data_dir": {"type": "string"},
            "client_version": {"type": "string"},
            "qr_code": {"type": "string"},
            "poll_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
            "folder_name": {"type": "string"},
            "duration_seconds": {"type": "number", "minimum": 0},
            "duration": {"type": "number", "minimum": 0},
            "permissions": {"type": "object"},
            "card_name": {"type": "string"},
            "role": {"type": "string"},
            "notify_id": {"$ref": "#/$defs/identifier"},
            "session_id": {"$ref": "#/$defs/identifier"},
            "login_id": {"$ref": "#/$defs/identifier"},
            "local_result_reference": {"type": "string"}
          }
        }
      }
    },
    "identifier": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "integer", "minimum": 1}
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "status", "result"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "qq.session.create",
            "qq.session.init",
            "qq.session.start_nt",
            "qq.login.connect",
            "qq.login.online",
            "qq.login.offline",
            "qq.login.list",
            "qq.login.quick",
            "qq.login.password",
            "qq.login.qr",
            "qq.login.poll",
            "qq.login.self_status",
            "qq.account.core",
            "qq.account.simple",
            "qq.message.subscribe",
            "qq.message.send",
            "qq.message.send_completion",
            "qq.peer.uid_by_uin",
            "qq.peer.uin_by_uid",
            "qq.peer.uid",
            "qq.peer.uin",
            "qq.message.history_include_self",
            "qq.message.history_by_seq",
            "qq.message.by_id",
            "qq.message.single",
            "qq.message.search",
            "qq.message.recall",
            "qq.message.forward",
            "qq.message.forward_comment",
            "qq.message.multi_forward",
            "qq.message.read",
            "qq.message.read_all",
            "qq.message.emoji_likes",
            "qq.message.emoji_likes_list",
            "qq.group.list",
            "qq.group.detail",
            "qq.group.members",
            "qq.group.member",
            "qq.friend.list",
            "qq.friend.cached",
            "qq.friend.requests",
            "qq.media.element",
            "qq.media.download",
            "qq.media.video_url",
            "qq.media.download_complete",
            "qq.file.list",
            "qq.file.search",
            "qq.file.download",
            "qq.file.forward",
            "qq.file.save",
            "qq.group.modify_name",
            "qq.group.modify_remark",
            "qq.group.mute_member",
            "qq.group.mute",
            "qq.group.kick",
            "qq.group.quit",
            "qq.group.approve",
            "qq.friend.approve",
            "qq.friend.approve_doubt",
            "qq.friend.doubt_requests",
            "qq.friend.add",
            "qq.friend.delete",
            "qq.friend.set_remark",
            "qq.profile.modify",
            "qq.profile.nickname",
            "qq.profile.long_nick",
            "qq.profile.birthday",
            "qq.profile.gender",
            "qq.profile.header",
            "qq.search.stranger",
            "qq.search.group",
            "qq.search.contact",
            "qq.search.message",
            "qq.search.file",
            "qq.online.status",
            "qq.online.devices",
            "qq.online.likes",
            "qq.online.set_like",
            "qq.online.check_like"
          ]
        },
        "status": {
          "const": "accepted"
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2"]
        },
        "result": {},
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "method"],
          "properties": {
            "service": {"type": "string"},
            "method": {"type": "string"}
          }
        }
      }
    }
  }
}
