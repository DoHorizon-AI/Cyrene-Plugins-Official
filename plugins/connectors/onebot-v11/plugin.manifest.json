{
  "schemaVersion": 1,
  "id": "cyrene.connectors.onebot-v11",
  "name": "Official OneBot v11 Connector",
  "version": "0.4.0",
  "description": "OneBot v11 compatibility transport for message.connector.v1.",
  "kind": "capability-plugin",
  "capabilities": [
    "message.connector.v1"
  ],
  "methods": [
    {
      "name": "send_message",
      "capability": "message.connector.v1",
      "interfaceVersion": "1",
      "executionMode": "service"
    },
    {
      "name": "inbound_message",
      "capability": "message.connector.v1",
      "interfaceVersion": "1",
      "executionMode": "service"
    },
    {
      "name": "inbound_request",
      "capability": "message.connector.v1",
      "interfaceVersion": "1",
      "executionMode": "service",
      "outputSchema": "../../../contracts/json/message-connector-v1-inbound-request.schema.json"
    },
    {
      "name": "respond_request",
      "capability": "message.connector.v1",
      "interfaceVersion": "1",
      "executionMode": "service",
      "inputSchema": "../../../contracts/json/message-connector-v1-request-response.schema.json"
    }
  ],
  "runtime": {
    "language": "csharp",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "runtimeProfile": "onebot-v11",
    "profiles": [
      {
        "name": "onebot-v11",
        "connectorFamily": "onebot_v11",
        "external": true
      }
    ],
    "launch": {
      "executable": "bin/cyrene-onebot-v11"
    }
  },
  "distribution": {
    "specVersion": "0.1",
    "descriptorRef": "package-descriptor.json",
    "publicationStatus": "CANDIDATE"
  },
  "compatibility": {
    "platformVersion": ">=0.1.0",
    "os": [
      "linux"
    ],
    "architectures": [
      "x86_64",
      "aarch64"
    ]
  },
  "configuration": {
    "schemaRef": "configuration.schema.json"
  },
  "secrets": {
    "requiredSecretRefs": [],
    "optionalSecretRefs": [
      "ONEBOT_HTTP_ACCESS_TOKEN"
    ]
  },
  "state": {
    "isStateful": true,
    "storageCategory": "cache",
    "migrationSupported": false,
    "downgradeSupported": true,
    "retentionPolicyOnUninstall": "retain"
  }
}
