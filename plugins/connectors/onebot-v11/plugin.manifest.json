{
  "schemaVersion": 1,
  "id": "cyrene.connectors.onebot-v11",
  "name": "Official OneBot v11 Connector",
  "version": "0.4.0",
  "description": "OneBot v11 compatibility transport for message.connector.v1.",
  "kind": "capability-plugin",
  "capabilities": [
    "message.connector.v1"
  ],
  "supportedServices": [
    "Cyrene-Exchange",
    "Cyrene-Navigator"
  ],
  "methods": [
    {
      "name": "send_message",
      "capability": "message.connector.v1",
      "interfaceVersion": "1",
      "executionMode": "service"
    },
    {
      "name": "inbound_message",
      "capability": "message.connector.v1",
      "interfaceVersion": "1",
      "executionMode": "service"
    },
    {
      "name": "inbound_request",
      "capability": "message.connector.v1",
      "interfaceVersion": "1",
      "executionMode": "service",
      "outputSchema": "../../../contracts/json/message-connector-v1-inbound-request.schema.json"
    },
    {
      "name": "respond_request",
      "capability": "message.connector.v1",
      "interfaceVersion": "1",
      "executionMode": "service",
      "inputSchema": "../../../contracts/json/message-connector-v1-request-response.schema.json"
    }
  ],
  "runtime": {
    "language": "csharp",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "runtimeProfile": "onebot-v11",
    "profiles": [
      {
        "name": "onebot-v11",
        "connectorFamily": "onebot_v11",
        "external": true
      }
    ],
    "launch": {
      "executable": "bin/cyrene-onebot-v11"
    }
  },
  "distribution": {
    "specVersion": "0.1",
    "descriptorRef": "package-descriptor.json",
    "publicationStatus": "CANDIDATE"
  },
  "compatibility": {
    "platformVersion": ">=0.1.0",
    "os": [
      "linux"
    ],
    "architectures": [
      "x86_64",
      "aarch64"
    ]
  },
  "configuration": {
    "schemaRef": "configuration.schema.json"
  },
  "secrets": {
    "requiredSecretRefs": [],
    "optionalSecretRefs": [
      "ONEBOT_HTTP_ACCESS_TOKEN"
    ]
  },
  "state": {
    "isStateful": true,
    "storageCategory": "cache",
    "migrationSupported": false,
    "downgradeSupported": true,
    "retentionPolicyOnUninstall": "retain"
  },
  "profiles": [
    "echo",
    "all"
  ],
  "contributions": {
    "nodes": [
      {
        "type": "connector.onebot_v11",
        "version": "0.4.0",
        "title": "OneBot v11 Connector",
        "owner": "Cyrene-Echo",
        "category": "Connector",
        "description": "Inbound and outbound messaging bridge via OneBot v11 protocol.",
        "color": "#3b82f6",
        "inputs": [
          {
            "name": "inbound",
            "label": "Inbound Message Stream",
            "kind": "endpoint"
          }
        ],
        "outputs": [
          {
            "name": "outbound",
            "label": "Outbound Message Stream",
            "kind": "endpoint"
          }
        ],
        "fields": [
          {
            "name": "transport",
            "label": "Transport Mode",
            "kind": "select",
            "choices": [
              "http_api",
              "forward_websocket",
              "reverse_websocket"
            ],
            "required": true
          },
          {
            "name": "endpointUrl",
            "label": "Endpoint URL",
            "kind": "text",
            "required": false
          }
        ],
        "defaults": {
          "transport": "forward_websocket",
          "endpointUrl": "ws://127.0.0.1:6700"
        },
        "execution": {
          "kind": "service",
          "adapter": "cyrene.connectors.onebot-v11",
          "mutableFields": [
            "endpointUrl"
          ],
          "checkpoint": false
        }
      }
    ],
    "mcp_tools": [
      "onebot_send_message",
      "onebot_inbound_message",
      "onebot_respond_request"
    ],
    "log_sources": [
      "onebot.messages",
      "onebot.events"
    ]
  }
}
