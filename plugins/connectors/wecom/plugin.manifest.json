{
  "schemaVersion": 1,
  "id": "cyrene.connectors.wecom",
  "name": "Official WeCom Unified Connector",
  "version": "0.2.0",
  "description": "WeCom unified message and tools connector implementing message.connector.v1 (application and OpenWS bot WebSocket) and tool.provider.v1 (@wecom/cli tools).",
  "kind": "capability-plugin",
  "capabilities": [
    "message.connector.v1",
    "tool.provider.v1"
  ],
  "supportedServices": [
    "Cyrene-Exchange",
    "Cyrene-Navigator"
  ],
  "methods": [
    {
      "capability": "message.connector.v1",
      "name": "send_message",
      "interfaceVersion": "1",
      "executionMode": "service"
    },
    {
      "capability": "tool.provider.v1",
      "name": "list_tools",
      "interfaceVersion": "1",
      "executionMode": "service"
    },
    {
      "capability": "tool.provider.v1",
      "name": "call_tool",
      "interfaceVersion": "1",
      "executionMode": "service"
    }
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "wecom_connector:WeComConnector",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {
      "executable": "prepared-runtime",
      "args": [
        "-B",
        "src/cyrene_plugin_runtime/bootstrap.py",
        "--entrypoint",
        "wecom_connector:WeComConnector"
      ]
    }
  },
  "compatibility": {
    "platformVersion": ">=0.1.0",
    "requiresPython": ">=3.11"
  },
  "configuration": {
    "schemaRef": "configuration.schema.json"
  },
  "secrets": {
    "optionalSecretRefs": [
      "WECOM_CORP_SECRET",
      "WECOM_BOT_SECRET"
    ]
  },
  "state": {
    "isStateful": false,
    "storageCategory": "stateless",
    "retentionPolicyOnUninstall": "retain"
  }
}
