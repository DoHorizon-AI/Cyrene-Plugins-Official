{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.dev/schemas/qq-package-lock-v1.json",
  "title": "Trusted Tencent QQ package lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "publisher", "packages"],
  "properties": {
    "schema": {"const": "cyrene.qq.package-lock.v1"},
    "publisher": {"const": "Tencent"},
    "packages": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "client_version",
        "package_format",
        "filename",
        "download_url",
        "source_page",
        "sha256"
      ],
      "properties": {
        "target": {
          "enum": ["linux-x86_64", "linux-aarch64", "windows-x86_64"]
        },
        "client_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "package_format": {"enum": ["deb", "rpm", "appimage", "exe", "msi"]},
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "download_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "source_page": {"type": "string", "format": "uri", "maxLength": 2048},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648}
      }
    }
  }
}
