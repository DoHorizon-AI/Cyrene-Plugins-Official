{
  "schemaVersion": 1,
  "id": "cyrene.tools.public-web",
  "name": "Public Web Tools",
  "version": "0.1.0",
  "licenseExpression": "Apache-2.0",
  "description": "Bounded public search, web reading, and source-backed document extraction.",
  "kind": "capability-plugin",
  "capabilities": ["tool.provider.v1"],
  "supportedServices": ["Cyrene-Navigator"],
  "methods": [
    {"name": "list_tools", "capability": "tool.provider.v1", "interfaceVersion": "1", "executionMode": "service"},
    {"name": "call_tool", "capability": "tool.provider.v1", "interfaceVersion": "1", "executionMode": "service"}
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "cyrene_public_web.plugin:PublicWebProvider",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {"executable": "prepared-runtime", "args": ["-B", "src/cyrene_plugin_runtime/bootstrap.py", "--entrypoint", "cyrene_public_web.plugin:PublicWebProvider"]}
  },
  "compatibility": {
    "platformVersion": ">=0.1.0",
    "requiresPython": ">=3.11",
    "os": ["linux", "windows", "darwin"],
    "architectures": ["x86_64", "aarch64"]
  },
  "configuration": {"schemaRef": "configuration.schema.json"},
  "secrets": {
    "requiredSecretRefs": [
      "public-web/caller-verification-key",
      "public-web/cursor-hmac-key",
      "public-web/state-dir",
      "public-web/artifact-bridge-token"
    ],
    "optionalSecretRefs": ["public-web/search-bearer-token"]
  },
  "state": {
    "isStateful": false,
    "storageCategory": "temporary",
    "retentionPolicyOnUninstall": "delete"
  }
}
