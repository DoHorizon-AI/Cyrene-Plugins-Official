{
  "schemaVersion": 1,
  "id": "cyrene.tools.dataset-validator",
  "name": "Training Dataset Deep Validator",
  "version": "0.2.0",
  "description": "Deep validation for training datasets (JSONL, JSON, CSV), checking token truncation risks, field distributions, and empty rates.",
  "kind": "capability-plugin",
  "capabilities": [
    "tool.dataset.validator.v1"
  ],
  "supportedServices": [
    "Cyrene-Catalyst"
  ],
  "methods": [
    {
      "name": "validate",
      "interfaceVersion": "1",
      "executionMode": "service",
      "inputSchema": "contracts/v1/schema.json#/$defs/ValidateRequest",
      "outputSchema": "contracts/v1/schema.json#/$defs/ValidateResponse"
    }
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "dataset_validator:DatasetValidatorPlugin",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {
      "executable": "prepared-runtime",
      "args": [
        "-B",
        "src/cyrene_plugin_runtime/bootstrap.py",
        "--entrypoint",
        "dataset_validator:DatasetValidatorPlugin"
      ]
    }
  },
  "compatibility": {
    "platformVersion": ">=0.1.0",
    "requiresPython": ">=3.11",
    "os": [
      "linux",
      "windows",
      "darwin"
    ]
  },
  "secrets": {},
  "state": {
    "isStateful": false,
    "storageCategory": "stateless",
    "retentionPolicyOnUninstall": "retain"
  },
  "profiles": [
    "reactor",
    "core",
    "all"
  ],
  "contributions": {
    "nodes": [
      {
        "type": "tool.dataset_validator",
        "version": "0.2.0",
        "title": "Dataset Deep Validator",
        "owner": "Cyrene-Core",
        "category": "Data",
        "description": "Deep validation for training datasets checking token truncation, empty rates, and distributions.",
        "color": "#f59e0b",
        "inputs": [
          {
            "name": "dataset",
            "label": "Raw Dataset",
            "kind": "dataset"
          }
        ],
        "outputs": [
          {
            "name": "report",
            "label": "Validation Report",
            "kind": "evaluation"
          }
        ],
        "fields": [
          {
            "name": "format",
            "label": "Dataset Format",
            "kind": "select",
            "choices": [
              "jsonl",
              "json",
              "csv"
            ],
            "required": true
          },
          {
            "name": "maxTokenLength",
            "label": "Max Token Length",
            "kind": "number",
            "integer": true,
            "minimum": 1,
            "maximum": 131072,
            "required": true
          }
        ],
        "defaults": {
          "format": "jsonl",
          "maxTokenLength": 4096
        },
        "execution": {
          "kind": "task",
          "adapter": "cyrene.tools.dataset-validator",
          "mutableFields": [
            "maxTokenLength"
          ],
          "checkpoint": false
        }
      }
    ],
    "mcp_tools": [
      "dataset_validator_validate"
    ],
    "log_sources": [
      "dataset.validation"
    ]
  }
}
