{
  "schemaVersion": 1,
  "id": "cyrene.tools.media",
  "name": "Media Library",
  "version": "0.1.0",
  "licenseExpression": "Apache-2.0",
  "description": "Actor-scoped image catalog, integrity validation, soft deletion, restoration, and PNG card rendering.",
  "kind": "capability-plugin",
  "capabilities": ["tool.provider.v1"],
  "supportedServices": ["Cyrene-Navigator"],
  "methods": [
    {
      "name": "list_tools",
      "capability": "tool.provider.v1",
      "interfaceVersion": "1",
      "executionMode": "service"
    },
    {
      "name": "call_tool",
      "capability": "tool.provider.v1",
      "interfaceVersion": "1",
      "executionMode": "service"
    }
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "cyrene_media.plugin:MediaProvider",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {
      "executable": "prepared-runtime",
      "args": [
        "-B",
        "src/cyrene_plugin_runtime/bootstrap.py",
        "--entrypoint",
        "cyrene_media.plugin:MediaProvider"
      ]
    }
  },
  "compatibility": {
    "platformVersion": ">=0.1.0",
    "requiresPython": ">=3.11",
    "os": ["linux", "windows", "darwin"],
    "architectures": ["x86_64", "aarch64"]
  },
  "configuration": {"schemaRef": "configuration.schema.json"},
  "secrets": {
    "requiredSecretRefs": [
      "media-library/caller-verification-key",
      "media-library/state-dir",
      "media-library/artifact-bridge-token"
    ],
    "optionalSecretRefs": []
  },
  "state": {
    "isStateful": true,
    "storageCategory": "persistent",
    "retentionPolicyOnUninstall": "retain"
  }
}
