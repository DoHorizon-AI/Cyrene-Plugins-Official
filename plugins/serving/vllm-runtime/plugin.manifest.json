{
  "schemaVersion": 1,
  "id": "cyrene.serving.vllm-runtime",
  "name": "vLLM Serving Runtime",
  "version": "0.1.0",
  "description": "Runs the vLLM accelerator process for one Reactor deployment and publishes validated model imports into the Platform artifact plane.",
  "kind": "gateway-runtime",
  "capabilities": [
    "execution.engine.v1"
  ],
  "supportedServices": [
    "Cyrene-Reactor"
  ],
  "methods": [
    {
      "name": "import_model",
      "interfaceVersion": "1",
      "executionMode": "service",
      "inputSchema": "contracts/v1/schema.json#/$defs/ImportRequest",
      "outputSchema": "contracts/v1/schema.json#/$defs/ImportResponse"
    },
    {
      "name": "start",
      "interfaceVersion": "1",
      "executionMode": "service",
      "inputSchema": "contracts/v1/schema.json#/$defs/StartRequest",
      "outputSchema": "contracts/v1/schema.json#/$defs/ExecutionResponse"
    },
    {
      "name": "inspect",
      "interfaceVersion": "1",
      "executionMode": "service",
      "outputSchema": "contracts/v1/schema.json#/$defs/ExecutionResponse"
    },
    {
      "name": "stop",
      "interfaceVersion": "1",
      "executionMode": "service",
      "outputSchema": "contracts/v1/schema.json#/$defs/ExecutionResponse"
    },
    {
      "name": "diagnostics",
      "interfaceVersion": "1",
      "executionMode": "service",
      "outputSchema": "contracts/v1/schema.json#/$defs/DiagnosticsPage"
    }
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "package_service_adapter:main",
    "protocol": "cyrene.serving.runtime.http.v1",
    "transport": "http",
    "connectionRefScheme": "cyrene-http-v1",
    "launch": {
      "executable": "prepared-runtime",
      "args": [
        "-B",
        "package_service_adapter.py"
      ]
    }
  },
  "compatibility": {
    "platformVersion": ">=0.1.0",
    "requiresPython": ">=3.11",
    "os": [
      "linux"
    ],
    "accelerators": [
      "nvidia-cuda"
    ]
  },
  "state": {
    "isStateful": false,
    "storageCategory": "stateless",
    "retentionPolicyOnUninstall": "retain"
  },
  "profiles": [
    "reactor",
    "all"
  ],
  "contributions": {
    "nodes": [
      {
        "type": "serving.vllm.deploy",
        "version": "0.1.0",
        "title": "vLLM Model Serving",
        "owner": "Cyrene-Reactor",
        "category": "Serving",
        "description": "Deploy and serve large language models with vLLM high-throughput engine.",
        "color": "#10b981",
        "inputs": [
          {
            "name": "model",
            "label": "Trained Model",
            "kind": "model"
          }
        ],
        "outputs": [
          {
            "name": "endpoint",
            "label": "Inference Endpoint",
            "kind": "endpoint"
          }
        ],
        "fields": [
          {
            "name": "modelPath",
            "label": "Model Path / Repo",
            "kind": "text",
            "required": true
          },
          {
            "name": "gpuCount",
            "label": "GPU Count",
            "kind": "number",
            "integer": true,
            "minimum": 1,
            "maximum": 64,
            "required": true
          },
          {
            "name": "quantization",
            "label": "Quantization",
            "kind": "select",
            "choices": [
              "none",
              "awq",
              "gptq",
              "fp8"
            ],
            "required": false
          }
        ],
        "defaults": {
          "modelPath": "/models/base",
          "gpuCount": 1,
          "quantization": "none"
        },
        "execution": {
          "kind": "service",
          "adapter": "cyrene.serving.vllm-runtime",
          "mutableFields": [
            "gpuCount",
            "quantization"
          ],
          "checkpoint": false
        }
      }
    ],
    "mcp_tools": [
      "vllm_import_model",
      "vllm_start_service",
      "vllm_inspect",
      "vllm_diagnostics"
    ],
    "log_sources": [
      "vllm.engine",
      "vllm.access"
    ]
  }
}
