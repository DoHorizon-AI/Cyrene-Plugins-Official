{
  "schemaVersion": 1,
  "id": "cyrene.providers.knowledge-graph",
  "name": "SQLite Knowledge Graph Provider",
  "version": "0.1.0",
  "licenseExpression": "Apache-2.0",
  "description": "Persistent tenant-isolated graph storage, search, traversal, and batch transfer for knowledge.graph.v1.",
  "kind": "capability-plugin",
  "capabilities": ["knowledge.graph.v1"],
  "supportedServices": ["Cyrene-Navigator"],
  "methods": [
    {"capability": "knowledge.graph.v1", "name": "upsert_nodes", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "get_node", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "search_nodes", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "delete_node", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "upsert_edges", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "get_edge", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "search_edges", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "delete_edge", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "expand", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "import_batch", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "knowledge.graph.v1", "name": "export_batch", "interfaceVersion": "1", "executionMode": "service"}
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "knowledge_graph_provider.plugin:KnowledgeGraphProvider",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {
      "executable": "prepared-runtime",
      "args": ["-B", "src/cyrene_plugin_runtime/bootstrap.py", "--entrypoint", "knowledge_graph_provider.plugin:KnowledgeGraphProvider"]
    }
  },
  "compatibility": {"platformVersion": ">=0.1.0", "requiresPython": ">=3.11"},
  "configuration": {"schemaRef": "configuration.schema.json"},
  "secrets": {"requiredSecretRefs": []},
  "state": {
    "isStateful": true,
    "storageCategory": "relational",
    "storageDescription": "Private SQLite graph database with tenant and namespace keys, bounded traversal, atomic imports, and retained state on uninstall.",
    "retentionPolicyOnUninstall": "retain"
  }
}
