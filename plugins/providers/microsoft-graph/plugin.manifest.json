{
  "schemaVersion": 1,
  "id": "cyrene.providers.microsoft-graph",
  "name": "Microsoft Graph Provider",
  "version": "0.1.0",
  "licenseExpression": "Apache-2.0",
  "description": "Fixed delegated Planner task tools and metadata-only reads for explicitly selected SharePoint sites and lists.",
  "kind": "capability-plugin",
  "capabilities": ["tool.provider.v1"],
  "supportedServices": ["Cyrene-Exchange"],
  "methods": [
    {"capability": "tool.provider.v1", "name": "list_tools", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "tool.provider.v1", "name": "call_tool", "interfaceVersion": "1", "executionMode": "service"}
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "microsoft_graph_provider.plugin:MicrosoftGraphProvider",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {
      "executable": "prepared-runtime",
      "args": ["-B", "src/cyrene_plugin_runtime/bootstrap.py", "--entrypoint", "microsoft_graph_provider.plugin:MicrosoftGraphProvider"]
    }
  },
  "compatibility": {"platformVersion": ">=0.1.0", "requiresPython": ">=3.11"},
  "configuration": {"schemaRef": "configuration.schema.json"},
  "secrets": {
    "requiredSecretRefs": [
      "microsoft-graph/exchange-verification-key",
      "microsoft-graph/account-center-provider-signing-key"
    ],
    "optionalSecretRefs": [
      "microsoft-graph/account-center-root-certificate",
      "microsoft-graph/account-center-client-certificate",
      "microsoft-graph/account-center-client-key"
    ]
  },
  "state": {"isStateful": false, "storageCategory": "stateless", "retentionPolicyOnUninstall": "retain"}
}
