{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cyrene.io/tool.provider.v1.azure-devops-observation/configuration.schema.json",
  "title": "Azure DevOps observation provider activation configuration",
  "type": "object",
  "required": [
    "exchange_caller_id",
    "exchange_verification_key_ref",
    "account_center",
    "organization",
    "tenant_id",
    "authorized_sources",
    "hostSecretRefs"
  ],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "exchange_caller_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "exchange_verification_key_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"},
    "organization": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}$",
      "description": "One host-bound Azure DevOps organization slug; callers cannot supply an organization or endpoint."
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid",
      "description": "Microsoft Entra tenant bound to this Azure DevOps organization and delegated profile."
    },
    "account_center": {
      "type": "object",
      "required": ["binding_id", "connection_ref", "transport", "caller_id", "signing_key_ref"],
      "properties": {
        "binding_id": {"type": "string", "minLength": 1, "maxLength": 256, "x-cyrene-host-provided": true},
        "connection_ref": {"type": "string", "minLength": 1, "maxLength": 512, "x-cyrene-host-provided": true},
        "transport": {"type": "string", "enum": ["local", "mtls"], "default": "local", "x-cyrene-host-provided": true},
        "caller_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "signing_key_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"},
        "mtls": {
          "type": "object",
          "properties": {
            "root_cert_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"},
            "client_cert_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"},
            "client_key_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"transport": {"const": "mtls"}}, "required": ["transport"]},
          "then": {"properties": {"mtls": {"required": ["root_cert_ref", "client_cert_ref", "client_key_ref"]}}, "required": ["mtls"]}
        }
      ]
    },
    "authorized_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["source_id", "kind", "project_id", "project_name", "profile_ref"],
            "properties": {
              "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
              "kind": {"const": "project_pipelines"},
              "project_id": {"type": "string", "format": "uuid"},
              "project_name": {"type": "string", "minLength": 1, "maxLength": 128},
              "profile_ref": {"type": "string", "format": "uuid", "x-cyrene-host-provided": true}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["source_id", "kind", "project_id", "project_name", "profile_ref", "pipeline_id"],
            "properties": {
              "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
              "kind": {"const": "pipeline_runs"},
              "project_id": {"type": "string", "format": "uuid"},
              "project_name": {"type": "string", "minLength": 1, "maxLength": 128},
              "profile_ref": {"type": "string", "format": "uuid", "x-cyrene-host-provided": true},
              "pipeline_id": {"type": "integer", "minimum": 1, "maximum": 2147483647}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["source_id", "kind", "project_id", "project_name", "profile_ref"],
            "properties": {
              "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
              "kind": {"const": "release_deployments"},
              "project_id": {"type": "string", "format": "uuid"},
              "project_name": {"type": "string", "minLength": 1, "maxLength": 128},
              "profile_ref": {"type": "string", "format": "uuid", "x-cyrene-host-provided": true},
              "definition_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
              "definition_environment_id": {"type": "integer", "minimum": 1, "maximum": 2147483647}
            },
            "allOf": [
              {"if": {"properties": {"definition_environment_id": {"type": "integer"}}, "required": ["definition_environment_id"]}, "then": {"required": ["definition_id"]}}
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60, "default": 15},
    "hostSecretRefs": {
      "type": "object",
      "description": "Stable refs to environment-variable names injected by the host; token values never appear in activation JSON.",
      "required": [
        "azure-devops-observation/exchange-verification-key",
        "azure-devops-observation/account-center-provider-signing-key"
      ],
      "properties": {
        "azure-devops-observation/exchange-verification-key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
        "azure-devops-observation/account-center-provider-signing-key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
        "azure-devops-observation/account-center-root-certificate": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
        "azure-devops-observation/account-center-client-certificate": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
        "azure-devops-observation/account-center-client-key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"account_center": {"properties": {"transport": {"const": "mtls"}}, "required": ["transport"]}}, "required": ["account_center"]},
      "then": {"properties": {"hostSecretRefs": {"required": ["azure-devops-observation/account-center-root-certificate", "azure-devops-observation/account-center-client-certificate", "azure-devops-observation/account-center-client-key"]}}}
    }
  ],
  "additionalProperties": false
}
