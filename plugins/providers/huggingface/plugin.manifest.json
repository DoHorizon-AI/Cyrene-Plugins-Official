{
  "schemaVersion": 1,
  "id": "cyrene.providers.huggingface",
  "name": "Hugging Face Hub Provider",
  "version": "0.1.0",
  "licenseExpression": "Apache-2.0",
  "description": "Profile-scoped Hub metadata and small artifact operations through Account Center leases.",
  "kind": "capability-plugin",
  "capabilities": ["tool.provider.v1"],
  "supportedServices": ["Cyrene-Exchange"],
  "methods": [
    {"capability": "tool.provider.v1", "name": "list_tools", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "tool.provider.v1", "name": "call_tool", "interfaceVersion": "1", "executionMode": "service"}
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "huggingface_provider.plugin:HuggingFaceProvider",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {"executable": "prepared-runtime", "args": ["-B", "src/cyrene_plugin_runtime/bootstrap.py", "--entrypoint", "huggingface_provider.plugin:HuggingFaceProvider"]}
  },
  "compatibility": {"platformVersion": ">=0.1.0", "requiresPython": ">=3.11"},
  "configuration": {"schemaRef": "configuration.schema.json"},
  "secrets": {
    "requiredSecretRefs": [
      "huggingface/exchange-verification-key",
      "huggingface/account-center-provider-signing-key"
    ],
    "optionalSecretRefs": [
      "huggingface/account-center-root-certificate",
      "huggingface/account-center-client-certificate",
      "huggingface/account-center-client-key"
    ]
  },
  "state": {"isStateful": false, "storageCategory": "stateless", "retentionPolicyOnUninstall": "retain"}
}
