{
  "schemaVersion": 1,
  "id": "cyrene.providers.knowledge-retrieval",
  "name": "Knowledge Bundle Retrieval",
  "version": "0.1.0",
  "licenseExpression": "Apache-2.0",
  "description": "Searches a fixed ArtifactRef registry after verifying the signed host caller context and server-side principal mapping.",
  "kind": "capability-plugin",
  "capabilities": ["tool.provider.v1"],
  "supportedServices": ["Cyrene-Navigator"],
  "methods": [
    {"name": "list_tools", "interfaceVersion": "1", "executionMode": "service"},
    {"name": "call_tool", "interfaceVersion": "1", "executionMode": "service"}
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "knowledge_retrieval_provider.plugin:KnowledgeRetrievalProvider",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {
      "executable": "prepared-runtime",
      "args": ["-B", "src/cyrene_plugin_runtime/bootstrap.py", "--entrypoint", "knowledge_retrieval_provider.plugin:KnowledgeRetrievalProvider"]
    }
  },
  "compatibility": {"platformVersion": ">=0.1.0", "requiresPython": ">=3.11"},
  "configuration": {"schemaRef": "configuration.schema.json"},
  "secrets": {
    "requiredSecretRefs": ["knowledge-retrieval/caller-context-verification-key"]
  },
  "state": {
    "isStateful": false,
    "storageCategory": "stateless",
    "storageDescription": "Reads immutable bundle artifacts from one configured root; no bundle content is copied into plugin state.",
    "retentionPolicyOnUninstall": "retain"
  }
}
