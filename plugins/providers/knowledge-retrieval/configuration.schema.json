{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cyrene.io/tool.provider.v1.knowledge-retrieval/configuration.schema.json",
  "title": "Signed knowledge retrieval activation configuration",
  "type": "object",
  "required": [
    "artifact_root",
    "trusted_caller",
    "trusted_principals",
    "bundle_registry",
    "hostSecretRefs"
  ],
  "properties": {
    "artifact_root": {"type": "string", "pattern": "^/[^\\u0000]{1,1023}$"},
    "trusted_caller": {
      "type": "object",
      "required": [
        "caller_workload",
        "audience",
        "issuer",
        "organization_id",
        "workspace_id",
        "verification_key_ref"
      ],
      "properties": {
        "caller_workload": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"},
        "audience": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"},
        "issuer": {"type": "string", "minLength": 1, "maxLength": 512},
        "organization_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "workspace_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "verification_key_ref": {"const": "knowledge-retrieval/caller-context-verification-key"}
      },
      "additionalProperties": false
    },
    "trusted_principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["issuer", "subject", "organization_id", "workspace_id", "principal_refs"],
        "properties": {
          "issuer": {"type": "string", "minLength": 1, "maxLength": 512},
          "subject": {"type": "string", "minLength": 1, "maxLength": 512},
          "organization_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "workspace_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "principal_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        },
        "additionalProperties": false
      }
    },
    "bundle_registry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["library_selector", "bundle_locator", "artifact_ref"],
        "properties": {
          "library_selector": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "bundle_locator": {"type": "string", "minLength": 1, "maxLength": 2048},
          "artifact_ref": {"$ref": "#/$defs/ArtifactRef"}
        },
        "additionalProperties": false
      }
    },
    "max_bundle_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456, "default": 268435456},
    "max_member_bytes": {"type": "integer", "minimum": 1, "maximum": 201326592, "default": 201326592},
    "max_search_limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20},
    "max_jsonl_records": {"type": "integer", "minimum": 1, "maximum": 2000000, "default": 500000},
    "max_query_chars": {"type": "integer", "minimum": 1, "maximum": 16384, "default": 4096},
    "hostSecretRefs": {
      "type": "object",
      "required": ["knowledge-retrieval/caller-context-verification-key"],
      "properties": {
        "knowledge-retrieval/caller-context-verification-key": {"$ref": "#/$defs/EnvironmentName"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "Sha256Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "EnvironmentName": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
    "ArtifactRef": {
      "type": "object",
      "required": ["uri", "digest", "size_bytes", "kind"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
        "digest": {"$ref": "#/$defs/Sha256Digest"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "manifest_digest": {"$ref": "#/$defs/Sha256Digest"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
