{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cyrene.io/memory.provider.v1.memory-sqlite/configuration.schema.json",
  "title": "SQLite memory provider activation configuration",
  "type": "object",
  "required": ["database_path", "embedding_model_id", "embedding_dimensions"],
  "properties": {
    "database_path": {"type": "string", "pattern": "^/[^\\u0000]{1,1023}$"},
    "embedding_model_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "embedding_profile_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "embedding_document_prefix": {"type": "string", "maxLength": 512, "default": ""},
    "embedding_query_prefix": {"type": "string", "maxLength": 512, "default": ""},
    "embedding_dimensions": {"type": "integer", "minimum": 1, "maximum": 4096},
    "embedding_endpoint": {"type": "string", "pattern": "^grpc://(?:127\\.0\\.0\\.1|localhost|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"},
    "embedding_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120, "default": 30},
    "recall_batch_size": {"type": "integer", "minimum": 16, "maximum": 4096, "default": 256},
    "max_top_k": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100}
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {"properties": {"embedding_document_prefix": {"minLength": 1}}, "required": ["embedding_document_prefix"]},
          {"properties": {"embedding_query_prefix": {"minLength": 1}}, "required": ["embedding_query_prefix"]}
        ]
      },
      "then": {"required": ["embedding_profile_id"]}
    }
  ],
  "additionalProperties": false
}
