{
  "schemaVersion": 1,
  "id": "cyrene.providers.cloud-management",
  "name": "Cloud Management Provider",
  "version": "0.1.0",
  "licenseExpression": "Apache-2.0",
  "description": "Signed, profile-scoped Azure, Google Cloud, and Runpod Pods management through fixed APIs and bounded vendor CLIs.",
  "kind": "capability-plugin",
  "capabilities": ["tool.provider.v1"],
  "supportedServices": ["Cyrene-Exchange"],
  "methods": [
    {"capability": "tool.provider.v1", "name": "list_tools", "interfaceVersion": "1", "executionMode": "service"},
    {"capability": "tool.provider.v1", "name": "call_tool", "interfaceVersion": "1", "executionMode": "service"}
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "cloud_management_provider.plugin:CloudManagementProvider",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {
      "executable": "prepared-runtime",
      "args": ["-B", "src/cyrene_plugin_runtime/bootstrap.py", "--entrypoint", "cloud_management_provider.plugin:CloudManagementProvider"]
    }
  },
  "compatibility": {"platformVersion": ">=0.1.0", "requiresPython": ">=3.11"},
  "configuration": {"schemaRef": "configuration.schema.json"},
  "secrets": {
    "requiredSecretRefs": ["cloud-management/exchange-verification-key"],
    "optionalSecretRefs": [
      "cloud-management/gcp-wif-credential-config",
      "cloud-management/runpod-api-key"
    ]
  },
  "state": {
    "isStateful": true,
    "storageCategory": "relational",
    "storageDescription": "Private bounded SQLite write-replay and operation-reference ledger; known terminal receipts expire after configured retention, while pending and unknown write tombstones are retained; resource request bodies and provider credentials are not stored.",
    "retentionPolicyOnUninstall": "retain"
  }
}
