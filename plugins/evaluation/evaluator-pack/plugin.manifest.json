{
  "schemaVersion": 1,
  "id": "cyrene.evaluation.evaluator-pack",
  "name": "Deterministic Evaluator Pack",
  "version": "0.1.0",
  "description": "Deterministic evaluation.runner.v1 evaluators: contains, regex, JSON structural equality, JSON Schema validation, and numeric tolerance.",
  "kind": "capability-plugin",
  "capabilities": [
    "evaluation.runner.v1"
  ],
  "methods": [
    {
      "name": "evaluate",
      "interfaceVersion": "1",
      "executionMode": "service",
      "inputSchema": "contracts/v1/schema.json#/$defs/EvaluateRequest",
      "outputSchema": "contracts/v1/schema.json#/$defs/EvaluateResponse"
    }
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "evaluator_pack:EvaluatorPackPlugin",
    "protocol": "cyrene.plugin.runtime.v1.DirectPluginRuntime",
    "launch": {
      "executable": "prepared-runtime",
      "args": [
        "-B",
        "src/cyrene_plugin_runtime/bootstrap.py",
        "--entrypoint",
        "evaluator_pack:EvaluatorPackPlugin"
      ]
    }
  },
  "compatibility": {
    "platformVersion": ">=0.1.0",
    "requiresPython": ">=3.11",
    "os": [
      "linux",
      "windows",
      "darwin"
    ]
  },
  "secrets": {},
  "state": {
    "isStateful": false,
    "storageCategory": "stateless",
    "retentionPolicyOnUninstall": "retain"
  }
}
