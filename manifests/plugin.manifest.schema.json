{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyrenePluginManifestDraftV1",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "schemaVersion",
    "kind",
    "capabilities",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+.*$"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "capability-plugin",
        "gateway-runtime",
        "provider-adapter",
        "tool-provider",
        "system-plugin"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "executionMode"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "capability": {
            "type": "string",
            "description": "Capability selected by this method when the plugin declares more than one."
          },
          "interfaceVersion": {
            "type": "string",
            "minLength": 1,
            "description": "Callable capability interface version, distinct from the plugin release version."
          },
          "executionMode": {
            "type": "string",
            "description": "Execution mode placement accepted by Platform (inline, worker, service). Adding or modifying execution modes requires normative Platform generic contract acceptance.",
            "enum": [
              "inline",
              "worker",
              "service"
            ]
          },
          "inputSchema": {
            "type": "string"
          },
          "outputSchema": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "python",
            "csharp",
            "java",
            "rust",
            "shell",
            "mixed"
          ]
        },
        "entrypoint": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "description": "Plugin-owned versioned data-plane protocol. Platform treats the resulting endpoint as an opaque connection reference."
        },
        "runtimeProfile": {
          "type": "string"
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "description": "Language-neutral package launch command consumed by Platform process supervision. The executable is either prepared-runtime or a safe package-relative path.",
          "required": [
            "executable"
          ],
          "properties": {
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "distribution": {
      "$ref": "#/$defs/connectorPackageReference"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "platformVersion": {
          "type": "string"
        },
        "requiresPython": {
          "type": "string"
        },
        "requiresDotnet": {
          "type": "string"
        },
        "requiresJava": {
          "type": "string"
        },
        "os": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architectures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accelerators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "schemaRef": {
          "type": "string"
        },
        "defaultSettings": {
          "type": "object"
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "requiredSecretRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalSecretRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "isStateful": {
          "type": "boolean"
        },
        "storageCategory": {
          "type": "string",
          "enum": [
            "relational",
            "vector",
            "document",
            "blob",
            "cache",
            "stateless"
          ]
        },
        "migrationSupported": {
          "type": "boolean"
        },
        "downgradeSupported": {
          "type": "boolean"
        },
        "retentionPolicyOnUninstall": {
          "type": "string",
          "enum": [
            "retain",
            "purge",
            "prompt"
          ]
        }
      }
    },
    "profiles": {
      "type": "array",
      "description": "Optional list of deployment/service profiles that bundle or enable this plugin (e.g. ['reactor', 'echo', 'yield', 'catalyst', 'core', 'all']).",
      "items": {
        "type": "string"
      }
    },
    "contributions": {
      "type": "object",
      "description": "Optional studio, tool, and observability contributions provided by this plugin.",
      "properties": {
        "nodes": {
          "type": "array",
          "description": "Studio workflow node contributions following the cyrene.studio.nodes.v1 specification.",
          "items": {
            "$ref": "#/$defs/studioNodeContribution"
          }
        },
        "mcp_tools": {
          "type": "array",
          "description": "MCP tools exposed by this plugin.",
          "items": {
            "type": "string"
          }
        },
        "log_sources": {
          "type": "array",
          "description": "Log or telemetry sources emitted by this plugin.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "connectorPackageReference": {
      "type": "object",
      "additionalProperties": false,
      "description": "A static reference to the Connector Package Spec descriptor. Package identity, version, capabilities, and runtime remain canonical top-level PluginManifest fields.",
      "required": [
        "specVersion",
        "descriptorRef",
        "publicationStatus"
      ],
      "properties": {
        "specVersion": {
          "const": "0.1"
        },
        "descriptorRef": {
          "type": "string",
          "minLength": 1
        },
        "publicationStatus": {
          "type": "string",
          "enum": [
            "NOT_PUBLISHED",
            "CANDIDATE",
            "PUBLISHED"
          ]
        },
        "descriptorDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "studioNodePort": {
      "type": "object",
      "description": "Input or output port definition for a Studio workflow node.",
      "required": [
        "name",
        "label",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,99}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "type": "string",
          "enum": [
            "dataset",
            "model",
            "compute",
            "evaluation",
            "endpoint",
            "agent-report"
          ]
        }
      }
    },
    "studioNodeField": {
      "type": "object",
      "description": "Configurable field definition for a Studio workflow node.",
      "required": [
        "name",
        "label",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,99}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "select"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 100
        },
        "required": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "integer": {
          "type": "boolean"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "studioNodeExecution": {
      "type": "object",
      "description": "Execution strategy and adapter binding for a Studio workflow node.",
      "required": [
        "kind",
        "adapter"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "reference",
            "task",
            "service",
            "external"
          ]
        },
        "adapter": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,99}$"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"
        },
        "mutableFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "checkpoint": {
          "type": "boolean"
        }
      }
    },
    "studioNodeContribution": {
      "type": "object",
      "description": "Studio node contribution conforming to cyrene.studio.nodes.v1.",
      "required": [
        "type",
        "version",
        "title",
        "owner",
        "category",
        "description",
        "color",
        "inputs",
        "outputs",
        "fields",
        "defaults",
        "execution"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,99}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "color": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/studioNodePort"
          },
          "maxItems": 32
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/studioNodePort"
          },
          "maxItems": 32
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/studioNodeField"
          },
          "maxItems": 64
        },
        "defaults": {
          "type": "object"
        },
        "execution": {
          "$ref": "#/$defs/studioNodeExecution"
        }
      }
    }
  }
}
